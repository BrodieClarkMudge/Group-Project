# ===== Linux/WSL Makefile =====
CXX := g++
CXXFLAGS := -std=c++17 -O2 -Wall -Wextra

# detect raylib via pkg-config, fallback if needed
RAYLIB_CFLAGS := $(shell pkg-config --cflags raylib 2>/dev/null)
RAYLIB_LIBS   := $(shell pkg-config --libs   raylib 2>/dev/null)
ifeq ($(strip $(RAYLIB_LIBS)),)
  RAYLIB_CFLAGS :=
  RAYLIB_LIBS := -lraylib -lGL -lm -lpthread -ldl -lrt -lX11
endif

# === all source files ===
SRCS := betterfarm.cpp \
        animal.cpp pig.cpp sheep.cpp cow.cpp chicken.cpp \
        menu.cpp options.cpp \
        Crop.cpp Regenerating.cpp Stalk.cpp Large.cpp \
        Berry.cpp Potato.cpp Pumpkin.cpp

# === automatically create matching .o list ===
OBJS := $(SRCS:.cpp=.o)

# default build
all: farm

# link step
farm: $(OBJS)
	$(CXX) $(CXXFLAGS) $(RAYLIB_CFLAGS) $(OBJS) -o farm $(RAYLIB_LIBS)

# compile step
%.o: %.cpp
	$(CXX) $(CXXFLAGS) $(RAYLIB_CFLAGS) -c $< -o $@

# clean
clean:
	rm -f farm $(OBJS)
