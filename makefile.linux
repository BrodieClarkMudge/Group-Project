# ===== Linux/WSL Makefile =====
CXX := g++
CXXFLAGS := -std=c++17 -O2 -Wall -Wextra

# Try pkg-config first; fallback to manual libs if raylib isn't found
RAYLIB_CFLAGS := $(shell pkg-config --cflags raylib 2>/dev/null)
RAYLIB_LIBS   := $(shell pkg-config --libs   raylib 2>/dev/null)
ifeq ($(strip $(RAYLIB_LIBS)),)
  RAYLIB_CFLAGS :=
  RAYLIB_LIBS := -lraylib -lGL -lm -lpthread -ldl -lrt -lX11
endif

FARM_SRCS := betterfarm.cpp animal.cpp pig.cpp sheep.cpp cow.cpp chicken.cpp menu.cpp options.cpp

all: farm

farm: $(FARM_SRCS)
	$(CXX) $(CXXFLAGS) $(RAYLIB_CFLAGS) $(FARM_SRCS) -o farm $(RAYLIB_LIBS)     # ← TAB here

clean:
	rm -f farm *.o    # ← TAB here
