# Compiler and flags
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -O2
LDFLAGS = -lraylib -lGL -lm -lpthread -ldl -lrt -lX11

# Directories
SRC_DIR = .
BUILD_DIR = build
ASSETS_DIR = assets

# Target executable
TARGET = betterfarm

# Source files (all .cpp files in current directory)
SOURCES = $(wildcard *.cpp)
OBJECTS = $(SOURCES:%.cpp=$(BUILD_DIR)/%.o)

# Header files for dependency tracking
HEADERS = $(wildcard *.h)

# Default target
all: $(BUILD_DIR) $(TARGET)

# Create build directory
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# Link object files to create executable
$(TARGET): $(OBJECTS)
	$(CXX) $(OBJECTS) -o $(TARGET) $(LDFLAGS)
	@echo "Build complete: $(TARGET)"

# Compile source files to object files
$(BUILD_DIR)/%.o: %.cpp $(HEADERS)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Run the game
run: $(TARGET)
	./$(TARGET)

# Clean build files
clean:
	rm -rf $(BUILD_DIR) $(TARGET)
	@echo "Clean complete"

# Install raylib (Ubuntu/Debian)
install-deps:
	sudo apt-get update
	sudo apt-get install -y libraylib-dev

# Rebuild everything
rebuild: clean all

.PHONY: all clean run install-deps rebuild